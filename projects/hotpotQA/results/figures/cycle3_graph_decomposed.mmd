---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	retrieve(retrieve)
	decompose(decompose)
	hop(hop)
	synthesize(synthesize)
	answer(answer)
	check(check)
	repair(repair)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> retrieve;
	answer --> check;
	check -.-> finish;
	check -.-> repair;
	decompose -.-> answer;
	decompose -.-> hop;
	hop -.-> synthesize;
	repair --> finish;
	retrieve --> decompose;
	synthesize --> check;
	finish --> __end__;
	hop -.-> hop;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
