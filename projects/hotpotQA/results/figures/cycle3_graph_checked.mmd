---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	retrieve(retrieve)
	answer(answer)
	check(check)
	repair(repair)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> retrieve;
	answer --> check;
	check -.-> finish;
	check -.-> repair;
	repair --> finish;
	retrieve --> answer;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
