---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	solver_a(solver_a)
	solver_b(solver_b)
	compare(compare)
	judge(judge)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> solver_a;
	__start__ --> solver_b;
	compare -.-> finish;
	compare -.-> judge;
	judge --> finish;
	solver_a --> compare;
	solver_b --> compare;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
